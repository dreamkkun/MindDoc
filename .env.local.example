# Set ONE of these API keys to enable the PDF/TXT/MD upload -> mindmap
# generation feature. If both are set, AI_PROVIDER decides which one is used
# (defaults to "claude" when both are present).

# Option A: Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5

# Option B: Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: force a provider instead of relying on auto-detection.
# AI_PROVIDER=claude

# Required for uploads: a Vercel Blob store, so files can go straight from the
# browser to storage without passing through the 4.5MB serverless function
# body limit. Auto-populated when deployed on Vercel with a Blob store linked
# to the project; for local dev run `vercel env pull` after linking one, or
# set it here manually.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here
